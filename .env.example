# Add to Invoice Ninja's .env (commented values are the defaults).

# Required. Create an Application in SUPER PDP; the secret is shown once.
# Sandbox or production is decided by the credential pair.
SUPERPDP_ENABLED=true
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=

# Only needed when the instance has several companies
#SUPERPDP_COMPANY_KEY=

# Documents dated before this day are never sent automatically, and received
# invoices created before it are not imported (default: install day)
#SUPERPDP_START_DATE=2026-11-01

#SUPERPDP_AUTO_SEND=true
#SUPERPDP_SEND_DELAY=60
#SUPERPDP_VALIDATE=true
#SUPERPDP_SEND_B2C=true
#SUPERPDP_REPORT_PAYMENTS=true
#SUPERPDP_IMPORT_INCOMING=true
#SUPERPDP_ATTACH_DOCUMENT=true
#SUPERPDP_SYNC_CRON='*/5 * * * *'

# Invoice content
# Business process (BT-23): B goods, S services, M mixed
#SUPERPDP_BUSINESS_PROCESS=S
# Empty = auto: a company without a VAT number is under the franchise
#SUPERPDP_VAT_FRANCHISE=
#SUPERPDP_VAT_FRANCHISE_TEXT='TVA non applicable, art. 293 B du CGI'
#SUPERPDP_VAT_EXEMPT_TEXT='Exonération de TVA'
# Seller electronic address (BT-34); default: the SIREN (scheme 0225)
#SUPERPDP_SELLER_ADDRESS=
SUPERPDP_IBAN=
SUPERPDP_BIC=
#SUPERPDP_PAYMENT_TERMS='Paiement à réception de facture'
#SUPERPDP_NOTE_PMT='Indemnité forfaitaire pour frais de recouvrement en cas de retard de paiement : 40 €'
#SUPERPDP_NOTE_PMD="Pénalités de retard : trois fois le taux d'intérêt légal"
#SUPERPDP_NOTE_AAB="Pas d'escompte pour paiement anticipé"
# Custom field holding the service date (BT-72), e.g. invoice1; unset by default
SUPERPDP_DELIVERY_DATE_FIELD=invoice1
